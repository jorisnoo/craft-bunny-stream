{
    "name": "jorisnoo/craft-bunny-stream",
    "description": "Bunny Stream integration for Craft CMS.",
    "type": "craft-plugin",
    "authors": [
        {
            "name": "Joris Noordermeer",
            "email": "contact@noordermeer.ch",
            "homepage": "https://github.com/jorisnoo"
        }
    ],
    "license": "MIT",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "bunny",
        "bunny.net",
        "video",
        "streaming"
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0",
        "toshy/bunnynet-php": "^9.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "pestphp/pest": "^3.8 || ^4.0",
        "phpstan/phpstan": "^2.1",
        "putyourlightson/craft-blitz": "^5.0",
        "roave/security-advisories": "dev-latest"
    },
    "suggest": {
        "putyourlightson/craft-blitz": "Allows templates to opt out of caching while videos process, and refreshes affected pages when encoding finishes."
    },
    "autoload": {
        "psr-4": {
            "Noo\\CraftBunnyStream\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noo\\CraftBunnyStream\\Tests\\": "tests/"
        }
    },
    "extra": {
        "handle": "bunny-stream",
        "name": "Bunny Stream",
        "developer": "Joris Noordermeer",
        "documentationUrl": "",
        "class": "Noo\\CraftBunnyStream\\BunnyStream"
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "test": "pest",
        "check": [
            "@composer --no-plugins validate --strict",
            "@composer --no-plugins audit --locked",
            "@test --fail-on-skipped",
            "@phpstan",
            "@check-cs"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
